{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "autoMemoryEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/context-check.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/env-verify.mjs"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/lint-check.mjs"
      },
      {
        "matcher": "Edit",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/apply-patch.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/tool-offload.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/retry-timeout.mjs"
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/compaction.mjs"
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/todo-sync.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/continuation.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/trace-log.mjs"
      },
      {
        "matcher": "",
        "command": "node {{SKILLS_DIR}}/hooks-framework/scripts/quality-metric.mjs"
      }
    ]
  },
  "_comment": "Hooks 配置由 hooks-framework 技能定义，详见 {{SKILLS_DIR}}/hooks-framework/hooks.yaml。如需自定义模型配置，请在本地创建 .claude/settings.local.json 并添加 env 变量。"
}
